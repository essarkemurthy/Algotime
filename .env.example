# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── ICICI Breeze API ──────────────────────────────────────────────────────────
# Get these from https://api.icicidirect.com/ → My API
BREEZE_API_KEY=your_api_key_here
BREEZE_API_SECRET=your_api_secret_here

# Session token — expires every 24 hours. Generate a fresh one each morning:
#   1. Log in to https://api.icicidirect.com/
#   2. Go to "Generate Session" (or use the API to get it programmatically)
#   3. Paste the token below
BREEZE_SESSION_TOKEN=your_session_token_here

# ── PostgreSQL (OPTIONAL) ─────────────────────────────────────────────────────
# Leave DB_URL blank to run without a database. The dashboard, live prices,
# signals and paper trading all work; only history that outlives the process is
# lost — stored candles, charts from the DB, and cross-session paper reports.
#
# To enable it:
#   1. Install PostgreSQL and create a database:
#        createdb trading_data
#   2. Set DB_URL below, then create the tables:
#        python scripts/setup_db.py
# Format: postgresql://username:password@host:port/database_name
DB_URL=

# ── Startup gap fill (OPTIONAL) ───────────────────────────────────────────────
# On startup the app brings the stored candle history current by running
# scripts/update_all.py in the background. It never blocks startup, runs at most
# once per calendar day, and is skipped entirely when DB_URL is blank.
# Needed because the app persists live ticks but not aggregated candles — without
# this, candle history only advances when you run update_all.py by hand.
STARTUP_GAP_FILL=true           # false to disable
STARTUP_GAP_FILL_DAYS=40        # look-back window passed to update_all.py

# ── Intraday signals (VWAP Reversal + ORB alerts) ─────────────────────────────
# All thresholds are optional; the values shown are the built-in defaults.
# These are ALERTS ONLY — the signal engine never places or routes any order.
SIGNAL_BAR_INTERVAL=5m          # bar cadence: 1m | 5m | 15m | 30m
SIGNAL_STRETCH_ATR=1.0          # VWAP-reversal: min ATR-multiple stretch from VWAP
SIGNAL_BULL_RSI_LOW=35
SIGNAL_BULL_RSI_HIGH=55
SIGNAL_BEAR_RSI_LOW=45
SIGNAL_BEAR_RSI_HIGH=65
SIGNAL_RSI_PERIOD=14
SIGNAL_ATR_PERIOD=14
SIGNAL_AVG_VOL_PERIOD=20        # bars for average-volume / ORB volume gate
SIGNAL_ORB_MINUTES=30           # opening-range window from 09:15
SIGNAL_VOL_MULT=1.5             # ORB breakout-bar volume >= VOL_MULT * avg volume

# Notification controls
SIGNAL_NOTIFY_ENABLED=true      # master kill-switch (false => log only, no alerts)
SIGNAL_DRY_RUN=false            # true => print notifications to console, send nothing
SIGNAL_NOTIFY_IN_APP=true       # in-app WebSocket toast (dashboard)
SIGNAL_NOTIFY_TELEGRAM=false    # opt-in; needs TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
SIGNAL_NOTIFY_WEBHOOK=false     # opt-in; needs SIGNAL_WEBHOOK_URL
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SIGNAL_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Quick-start commands
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Set up the DB schema (run once):
#      python scripts/setup_db.py
#
# 2. Bulk-download 1 year of historical candles (all universes):
#      python scripts/bulk_download.py
#
#    Or pick a specific universe / interval:
#      python scripts/bulk_download.py --universe indices
#      python scripts/bulk_download.py --universe nifty50
#      python scripts/bulk_download.py --universe all --intervals 1day
#
#    See estimated API calls before committing:
#      python scripts/bulk_download.py --estimate
#
#    Resume an interrupted run (session token may need refresh):
#      python scripts/bulk_download.py --resume
#
#    Verify downloaded data integrity:
#      python scripts/bulk_download.py --verify
#
# 3. Start the live collector (real-time ticks + intraday candles):
#      python collect.py
#
# 4. Start the trading dashboard:
#      python app.py
#      → Open http://localhost:8000
#
# ─────────────────────────────────────────────────────────────────────────────
# Rate limits (Breeze API)
# ─────────────────────────────────────────────────────────────────────────────
# Hard limit:  75 REST calls/minute, ~4500 calls/day
# bulk_download.py uses: 55 calls/min, stops at 4400 calls/day
#
# Full "all" universe (~4600 calls) spans two sessions.
# Use --resume with a fresh session token the next day to finish.
# ─────────────────────────────────────────────────────────────────────────────

# ── Live (real-money) order bridge: follows the options paper engine on the broker
# account. Both gates are needed: this flag AND a daily arm with the confirmation
# phrase on the paper page. Leave unset to make real orders impossible.
LIVE_ORDERS_ENABLED=0
# Position size is computed per entry from the broker's funds (F&O allocation +
# unallocated bank balance, read via get_funds, ≤ 60 s old):
#   lots = min(LIVE_MAX_LOTS,
#              risk budget (LIVE_RISK_PCT % of capital) / risk per lot (premium x paper SL 30%),
#              LIVE_EXPOSURE_PCT % of capital / premium per lot,
#              remaining LIVE_TOTAL_EXPOSURE_PCT % room / premium per lot,
#              spendable cash (capital less LIVE_CASH_BUFFER_PCT) / premium per lot,
#              LIVE_MAX_PREMIUM / premium per lot)
# 0 lots = the entry is skipped and the journal says what one lot would need.
LIVE_LOTS=0                  # 0 = size from funds; N = fixed N lots (still cash-checked)
LIVE_MAX_LOTS=5
LIVE_MAX_OPEN=1
LIVE_RISK_PCT=2              # % of capital at risk per trade (at the paper stop)
LIVE_EXPOSURE_PCT=25         # max premium of one entry, % of capital
LIVE_TOTAL_EXPOSURE_PCT=50   # max premium across all open live positions, % of capital
LIVE_CASH_BUFFER_PCT=5       # never spend the last 5% (brokerage, taxes, slippage)
LIVE_DAILY_LOSS_CAP=3000     # absolute daily loss ceiling (disarms) ...
LIVE_DAILY_LOSS_PCT=3        # ... and relative, % of capital at arming; the lower one applies
LIVE_MAX_PREMIUM=20000       # absolute ceiling on premium x qty for one entry
LIVE_MAX_TRADES=3            # live entries per day
LIVE_MAX_CONSEC_LOSSES=2     # disarm after this many losing live exits in a row
LIVE_CAPITAL=0               # >0: size against at most this much capital, whatever the broker holds
